{
  "manifest_version": 3,
  "name": "浏览器使用日记",
  "version": "1.0.0",
  "description": "只在本机统计你访问过的站点停留时长，popup 展示今日柱状图与近 7 天趋势。不读取完整网址、不上传任何数据。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "浏览器使用日记",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  }
}
